# Supabase project credentials for local administrator scripts
# NEVER commit your service role key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optional custom admin email (defaults to admin@bookloop.test)
SEED_ADMIN_EMAIL=

# Optional pre-set passwords for base user accounts (leave empty to auto-generate)
SEED_KUSHAGRA_PASSWORD=
SEED_BHAGYESH_PASSWORD=
SEED_ADMIN_PASSWORD=

# Required safety flag for seed.mjs (must be true to run)
SEED_ALLOWED=false

# Password assigned to seeded @demo.test accounts (never use production credentials)
SEED_DEMO_PASSWORD=
